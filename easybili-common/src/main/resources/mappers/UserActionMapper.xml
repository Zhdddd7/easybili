<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.easybili.mappers.UserActionMapper">
    <!-- 通用查询条件 -->
    <sql id="query_condition">
        <if test="query.videoId != null">AND u.video_id = #{query.videoId}</if>
        <if test="query.commentId != null">AND u.comment_id = #{query.commentId}</if>
        <if test="query.actionType != null">AND u.action_type = #{query.actionType}</if>
        <if test="query.userId != null">AND u.user_id = #{query.userId}</if>
        <if test="query.actionTypeArray != null and query.actionTypeArray.length > 0">
            and u.action_type in (<foreach collection="query.actionTypeArray" item="item" separator=","> #{item}</foreach> )
        </if>
        <if test="query.orderBy != null and query.orderBy != ''">
            ORDER BY ${query.orderBy}
        </if>
        <if test="query.simplePage != null">
            LIMIT #{query.simplePage.start}, #{query.simplePage.end}
        </if>

    </sql>

    <!-- 插入 -->
    <insert id="insert" parameterType="com.easybili.entities.po.UserAction">
        INSERT INTO user_action (
        video_id, video_user_id, comment_id, action_type, action_count, user_id, action_time
        )
        VALUES (
        #{videoId}, #{videoUserId}, #{commentId}, #{actionType}, #{actionCount}, #{userId}, #{actionTime}
        )
    </insert>

    <!-- 更新 -->
    <update id="update" parameterType="com.easybili.entities.po.UserAction">
        UPDATE user_action
        SET video_id = #{videoId},
        video_user_id = #{videoUserId},
        comment_id = #{commentId},
        action_type = #{actionType},
        action_count = #{actionCount},
        user_id = #{userId},
        action_time = #{actionTime}
        WHERE action_id = #{actionId}
    </update>

    <!-- 删除 -->
    <delete id="deleteById" parameterType="int">
        DELETE FROM user_action WHERE action_id = #{actionId}
    </delete>

    <!-- 根据 ID 查询 -->
    <select id="selectById" parameterType="int" resultType="com.easybili.entities.po.UserAction">
        SELECT * FROM user_action WHERE action_id = #{actionId}
    </select>

    <select id="selectByVideoIdAndCommentIdAndActionTypeAndUserId" resultType="com.easybili.entities.po.UserAction">
        SELECT * FROM user_action
        WHERE video_id = #{videoId}
        AND comment_id = #{commentId}
        AND action_type = #{actionType}
        AND user_id = #{userId}
    </select>

    <!-- 根据 Query 条件查询 -->
    <select id="selectByQuery" parameterType="com.easybili.entities.query.UserActionQuery" resultType="com.easybili.entities.po.UserAction">
        SELECT u.*
        <if test="query.queryVideoInfo">
            , v.video_cover videoCover, v.video_name videoName
        </if>
        FROM user_action u
        <if test="query.queryVideoInfo">
            left join video_info v on u.video_id = v.video_id
        </if>
        WHERE 1=1
        <include refid="query_condition"/>
    </select>
</mapper>
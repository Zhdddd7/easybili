    <sql id="query_condition">
        <where>
            <if test="query.categoryId != null">
                AND v.category_id = #{query.categoryId}
            </if>
            <if test="query.videoId != null">
                AND v.video_id = #{query.videoId}
            </if>
            <if test="query.pCategoryId != null">
                AND v.p_category_id = #{query.pCategoryId}
            </if>

            <if test="query.userId != null and query.userId != ''">
                AND v.user_id = #{query.userId}
            </if>
            <if test="query.status != null">
                AND v.status = #{query.status}
            </if>
            <if test="query.excludeStatusArray != null and query.excludeStatusArray.length > 0">
                AND v.status NOT IN
                <foreach collection="query.excludeStatusArray" item="status" open="(" separator="," close=")">
                    #{status}
                </foreach>
            </if>
            <if test="query.videoNameFuzzy != null and query.videoNameFuzzy != ''">
                AND v.video_name LIKE CONCAT('%', #{query.videoNameFuzzy}, '%')
            </if>
        </where>
    </sql>



    <select id="selectById"  parameterType="String" resultType="com.easybili.entities.po.VideoInfoPost">
        SELECT * FROM video_info_post WHERE video_id = #{videoId}

    <insert id="insert" parameterType="com.easybili.entities.po.VideoInfoPost">
        INSERT INTO video_info_post (
        video_id, video_cover, video_name, user_id, create_time, last_update, p_category_id,
        category_id, status, post_type, origin_info, tags, introduction, interaction, duration
        ) VALUES (
        #{videoId}, #{videoCover}, #{videoName}, #{userId}, #{createTime}, #{lastUpdate}, #{pCategoryId},
        #{categoryId}, #{status}, #{postType}, #{originInfo}, #{tags}, #{introduction}, #{interaction}, #{duration}
        )
    </insert>


    <update id="updateByVideoId">
        UPDATE video_info_post
        <set>
            <if test="videoUpdate.videoCover != null">video_cover = #{videoUpdate.videoCover},</if>
            <if test="videoUpdate.videoName != null">video_name = #{videoUpdate.videoName},</if>
            <if test="videoUpdate.userId != null">user_id = #{videoUpdate.userId},</if>
            <if test="videoUpdate.lastUpdate != null">last_update = #{videoUpdate.lastUpdate},</if>
            <if test="videoUpdate.pCategoryId != null">p_category_id = #{videoUpdate.pCategoryId},</if>
            <if test="videoUpdate.categoryId != null">category_id = #{videoUpdate.categoryId},</if>
            <if test="videoUpdate.status != null">status = #{videoUpdate.status},</if>
            <if test="videoUpdate.postType != null">post_type = #{videoUpdate.postType},</if>
            <if test="videoUpdate.originInfo != null">origin_info = #{videoUpdate.originInfo},</if>
            <if test="videoUpdate.tags != null">tags = #{videoUpdate.tags},</if>
            <if test="videoUpdate.introduction != null">introduction = #{videoUpdate.introduction},</if>
            <if test="videoUpdate.interaction != null">interaction = #{videoUpdate.interaction},</if>
            <if test="videoUpdate.duration != null">duration = #{videoUpdate.duration},</if>
        </set>
        WHERE video_id = #{videoId}
    </update>


    <delete id="deleteById" parameterType="String">
        DELETE FROM video_info_post WHERE video_id = #{videoId}
    </delete>

    <select id="selectList" resultType="com.easybili.entities.po.VideoInfoPost">
        select v.*
        <if test="query.queryCountInfo">
            , c.play_count, c.like_count, c.danmu_count, c.comment_count, c.coin_count, c.collect_count, c.recommend_type
        </if>
        <if test="query.queryUserInfo">
            , u.user_name, u.avatar
        </if>
        from video_info_post v
        <if test="query.queryCountInfo">
            left join video_info c on c.video_id = v.video_id
        </if>
        <if test="query.queryUserInfo">
            left join user_info u on u.user_id = v.user_id
        </if>
        <include refid="query_condition"/>
        <if test="query.orderBy != null">
            order by ${query.orderBy}
        </if>
        <if test="query.simplePage != null">
            limit #{query.simplePage.start}, #{query.simplePage.end}
        </if>
    </select>

    <select id="findCountByParam" resultType="java.lang.Integer">
        select count(1)
        from video_info_post v
        <include refid="query_condition"/>
    </select>

    <update id="updateByParam">
        UPDATE video_info_post v
        <set>
            <if test="videoUpdate.videoCover != null">v.video_cover = #{videoUpdate.videoCover},</if>
            <if test="videoUpdate.videoName != null">v.video_name = #{videoUpdate.videoName},</if>
            <if test="videoUpdate.userId != null">v.user_id = #{videoUpdate.userId},</if>
            <if test="videoUpdate.lastUpdate != null">v.last_update = #{videoUpdate.lastUpdate},</if>
            <if test="videoUpdate.pCategoryId != null">v.p_category_id = #{videoUpdate.pCategoryId},</if>
            <if test="videoUpdate.categoryId != null">v.category_id = #{videoUpdate.categoryId},</if>
            <if test="videoUpdate.status != null">v.status = #{videoUpdate.status},</if>
            <if test="videoUpdate.postType != null">v.post_type = #{videoUpdate.postType},</if>
            <if test="videoUpdate.originInfo != null">v.origin_info = #{videoUpdate.originInfo},</if>
            <if test="videoUpdate.tags != null">v.tags = #{videoUpdate.tags},</if>
            <if test="videoUpdate.introduction != null">v.introduction = #{videoUpdate.introduction},</if>
            <if test="videoUpdate.interaction != null">v.interaction = #{videoUpdate.interaction},</if>
            <if test="videoUpdate.duration != null">v.duration = #{videoUpdate.duration},</if>
        </set>
        <include refid="query_condition"/>



    </update>

